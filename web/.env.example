# Copy to .env.local and fill in. NEVER commit real values.

# --- Supabase (Dashboard -> Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser. Used by Phase 8 alerts.
SUPABASE_SERVICE_ROLE_KEY=
# Session-pooler connection string (Dashboard -> Connect). Used only by scripts/*.mjs.
SUPABASE_DB_URL=

# --- App ---
# AMC developer API key (server-only).
AMC_VENDOR_KEY=
# Public URL of the deployed site, e.g. https://yourapp.vercel.app
# (used in auth email redirects; defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# --- Later (Phase 8) ---
# TELEGRAM_BOT_TOKEN=
