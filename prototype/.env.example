# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required: your AMC API vendor key
AMC_VENDOR_KEY=your-amc-vendor-key

# Optional: Telegram drop-alerts (assistant.py). Without these, alerts print to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: set to 1 to enable the Flask debugger for local dev only (never in production).
FLASK_DEBUG=
